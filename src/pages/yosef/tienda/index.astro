---
import YosefLayout from '../../../layouts/YosefLayout.astro';
import Header from '../../../components/yosef/Header.astro';
import Footer from '../../../components/yosef/Footer.astro';
import '../../../styles/yosef/tienda.css';
const products=[{id:'cuaderno',name:'Cuaderno creativo',category:'Papelería',price:12,desc:'Un espacio para apuntar ideas y proyectos.',image:'/yosef_quimico_new.png'},{id:'kit',name:'Kit de creador',category:'Kits',price:24,desc:'Materiales para empezar a dar forma a tus ideas.',image:'/yosef_prototipador.png'},{id:'lamina',name:'Lámina Yosef',category:'Ilustración',price:9,desc:'Una lámina inspirada en el universo Yosef Origen.',image:'/yosef_quimico.png'}];
const categories=['Todos',...new Set(products.map(p=>p.category))];const whatsapp=import.meta.env.PUBLIC_YOSEF_WHATSAPP??'';
---
<YosefLayout title="Tienda | Yosef Origen"><Header title="YOSEF ORIGEN" variant="header_2"/><main class="shop-page"><section class="shop"><header class="shop-hero"><p class="eyebrow">Yosef Origen · Tienda</p><h1>Ideas que cobran vida</h1><p>Explora la colección y prepara tu pedido directamente con nosotros.</p><button id="open">Mi carrito <span id="count">0</span></button></header><div class="catalog-head"><h2>Catálogo</h2><nav class="categories" aria-label="Categorías">{categories.map(c=><button data-filter={c}>{c}</button>)}</nav></div><div class="grid">{products.map(p=><article class="card" data-category={p.category}><button class="product-image" data-detail={p.id} aria-label={'Ver '+p.name}><img src={p.image} alt={p.name}/></button><div class="card-body"><small>{p.category}</small><h3>{p.name}</h3><p>{p.desc}</p><div class="actions"><strong>{p.price.toFixed(2)} €</strong><button data-add={p.id}>Añadir</button></div><em>Muestra · precio por confirmar</em></div></article>)}</div><dialog id="detail"></dialog><aside id="cart" hidden><header><h2>Tu pedido</h2><button id="close">×</button></header><div id="body"></div></aside><p class="disclaimer">Catálogo de demostración: artículos e importes pendientes de confirmar.</p></section></main><Footer/></YosefLayout>
<script define:vars={{products,whatsapp}}>
const bag=new Map();const cart=document.querySelector('#cart'),body=document.querySelector('#body'),money=n=>n.toFixed(2)+' €';try{JSON.parse(localStorage.getItem('yosef-cart')||'[]').forEach(([i,n])=>{if(products.some(p=>p.id===i))bag.set(i,n)})}catch{}
function render(){let rows=[...bag].map(([id,n])=>({...products.find(p=>p.id===id),n})).filter(p=>p.id);document.querySelector('#count').textContent=rows.reduce((a,p)=>a+p.n,0);if(!rows.length){body.innerHTML='<p>El carrito está vacío.</p>';return}let total=rows.reduce((a,p)=>a+p.price*p.n,0);body.innerHTML='<ul>'+rows.map(p=>'<li>'+p.name+' × '+p.n+' '+money(p.price*p.n)+' <button data-q="'+p.id+'" data-d="-1">−</button><button data-q="'+p.id+'" data-d="1">+</button></li>').join('')+'</ul><p class="total">Total orientativo <b>'+money(total)+'</b></p><form id="checkout"><h3>Entrega y pago</h3><label>Nombre<input name="name" required></label><label>Teléfono<input name="phone" type="tel" required></label><label>Dirección<textarea name="address" required></textarea></label><label>Notas<textarea name="notes"></textarea></label><p class="payment">Pago contra entrega</p><button class="submit">Preparar pedido en WhatsApp</button></form><div id="order"></div>'}
function save(){localStorage.setItem('yosef-cart',JSON.stringify([...bag]));render()}render();document.querySelector('#open').onclick=()=>cart.hidden=!cart.hidden;document.querySelector('#close').onclick=()=>cart.hidden=true;
document.querySelectorAll('[data-filter]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.card').forEach(c=>c.hidden=b.dataset.filter!=='Todos'&&c.dataset.category!==b.dataset.filter)});document.querySelector('[data-filter="Todos"]').classList.add('active');document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{bag.set(b.dataset.add,(bag.get(b.dataset.add)||0)+1);cart.hidden=false;save()});
document.querySelectorAll('[data-detail]').forEach(b=>b.onclick=()=>{let p=products.find(x=>x.id===b.dataset.detail),d=document.querySelector('#detail');d.innerHTML='<button id="x">×</button><img src="'+p.image+'"><h2>'+p.name+'</h2><p>'+p.desc+'</p><b>'+money(p.price)+'</b><p>Muestra · precio por confirmar</p><button id="dadd">Añadir al carrito</button>';d.showModal();d.querySelector('#x').onclick=()=>d.close();d.querySelector('#dadd').onclick=()=>{bag.set(p.id,(bag.get(p.id)||0)+1);d.close();cart.hidden=false;save()}});
body.onclick=e=>{let b=e.target.closest('[data-q]');if(!b)return;let n=(bag.get(b.dataset.q)||0)+Number(b.dataset.d);n?bag.set(b.dataset.q,n):bag.delete(b.dataset.q);save()};body.onsubmit=e=>{if(e.target.id!=='checkout')return;e.preventDefault();let f=new FormData(e.target),lines=[...bag].map(([id,n])=>{let p=products.find(x=>x.id===id);return p.name+' × '+n+' — '+money(p.price*n)}).join('\n'),total=[...bag].reduce((a,[id,n])=>a+products.find(p=>p.id===id).price*n,0),msg=['Pedido Yosef Origen','',lines,'','Total: '+money(total),'Pago contra entrega','','Nombre: '+f.get('name'),'Teléfono: '+f.get('phone'),'Dirección: '+f.get('address'),f.get('notes')].filter(Boolean).join('\n'),num=whatsapp.replace(/\D/g,'');document.querySelector('#order').innerHTML='<a class="wa" href="https://wa.me/'+num+'?text='+encodeURIComponent(msg)+'" target="_blank" rel="noopener">Abrir WhatsApp y enviar pedido</a>'+(!num?'<small>Configura PUBLIC_YOSEF_WHATSAPP para dirigir el pedido a la tienda.</small>':'')+'<small>Aún no se guarda en una base de datos.</small>'};
</script>
<script>
  import '../../../scripts/yosef-scroll.ts';
</script>
