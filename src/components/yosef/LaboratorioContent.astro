---
import { getCollection, render } from 'astro:content';
import LaboratorioAccordion from './LaboratorioAccordion.svelte';

const entries = (await getCollection('laboratorio'))
  .sort((a, b) => a.data.order - b.data.order);

const sections = await Promise.all(entries.map(async (entry) => ({
  entry,
  Content: (await render(entry)).Content,
})));

// Definir orden de categorías
const categoryOrder = [
  'Introducción',
  'Empieza a crear',
  // 'cursos',
  // 'herramientas',
];

const categoryNames: Record<string, string> = {
  Introducción: 'Introducción',
  'Empieza a crear': "Empieza a crear",
  // cursos: 'Cursos y tutoriales',
  // herramientas: 'Herramientas',
  
};

const categoryIcons: Record<string, string> = {
  Introducción: '📄',
  'Empieza a crear': '🏗️',
  // cursos: '🎓',
  // herramientas: '🛠',

};


const normalizeName = (value: string | undefined) =>
  (value ?? '')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[_-]+/g, ' ')
    .trim();

type BaseEntry = {
  title: string;
  slug: string;
  parent?: string;
  order: number;
  subsections: string[];
};

type NestedEntry = BaseEntry & {
  children: NestedEntry[];
};

const buildNestedEntries = (entries: BaseEntry[], parentName?: string): NestedEntry[] => {
  const normalizedParent = parentName ? normalizeName(parentName) : '';

  return entries
    .filter((entry) => {
      const parentValue = normalizeName(entry.parent);
      if (!parentName) {
        return !parentValue || parentValue === '';
      }

      return parentValue === normalizedParent;
    })
    .map((entry) => ({
      ...entry,
      children: buildNestedEntries(entries, entry.title),
    }))
    .sort((a, b) => a.order - b.order);
};

const categories = categoryOrder
  .filter((slug) => sections.some((s) => s.entry.data.category === slug))
  .map((slug) => {
    const categoryEntries = sections
      .filter((s) => s.entry.data.category === slug)
      .map((s) => ({
        title: s.entry.data.title,
        slug: s.entry.id.replace(/\.(md|mdx)$/, '').replace(/[/\\]/g, '-'),
        parent: s.entry.data.parent,
        order: s.entry.data.order,
        subsections: s.entry.data.subsections || [],
      }))
      .sort((a, b) => a.order - b.order);

    const entries = buildNestedEntries(categoryEntries);

    return {
      slug,
      title: categoryNames[slug] || slug,
      icon: categoryIcons[slug] || slug,
      entries,
    };
  });

const orderedArticleSlugs = categories.flatMap((category) =>
  category.entries.map((entry: NestedEntry) => entry.slug),
);
const defaultCategory = categories.length > 0 ? categories[0].slug : '';
---

<div class="lab-layout">
  <LaboratorioAccordion
    categories={categories}
    defaultCategory={defaultCategory}
    client:load
  />
  
  <main class="lab-content">

    <!-- HOME VIEW: Preview cards -->
    <section class="lab-home" style="display: grid;">
      <header class="lab-intro">
        <div style="display: grid; gap: 10px;">
          <span class="lab-intro-badge">🚀 Bienvenido al</span>
          <h1 class="lab-home-title">LABORATORIO</h1>
          <h2 class="lab-home-subtitle">Explora las categorías y encuentra guías, recursos y herramientas para tus proyectos.</h2>
        </div>
        <img src="/yosef_quimico.png" alt="yosef_quimico" >
      </header>
      <hr>
      <div class="lab-home-grid">
        {categories.map((cat) => (
          <article class="lab-home-card" data-article={cat.entries[0]?.slug || ''}>
            <div class="lab-home-card-icon">{cat.icon}</div>
            <h2>{cat.title}</h2>
            <p>{cat.entries[0]?.title || 'Explorar categoría'}</p>
            <span class="lab-home-card-count">{cat.entries.length} artículo{cat.entries.length !== 1 ? 's' : ''}</span>
          </article>
        ))}
      </div>
    </section>

    {sections.map(({ entry, Content }, index) => {
      const Heading = index === 0 ? 'h1' : 'h2';
      const cat = entry.data.category;
      const slug = entry.id.replace(/\.(md|mdx)$/, '').replace(/[/\\]/g, '-');
      const parent = entry.data.parent;
      const currentIndex = orderedArticleSlugs.indexOf(slug);
      const prevSlug = currentIndex > 0 ? orderedArticleSlugs[currentIndex - 1] : null;
      const nextSlug = currentIndex >= 0 && currentIndex < orderedArticleSlugs.length - 1 ? orderedArticleSlugs[currentIndex + 1] : null;
      const prevTitle = prevSlug ? sections.find((s) => s.entry.id.replace(/\.(md|mdx)$/, '').replace(/[/\\]/g, '-') === prevSlug)?.entry.data.title : null;
      const nextTitle = nextSlug ? sections.find((s) => s.entry.id.replace(/\.(md|mdx)$/, '').replace(/[/\\]/g, '-') === nextSlug)?.entry.data.title : null;

      return (
        <>
          <article
            id={slug}
            class="lab-card lab-layer"
            data-layer={cat}
            data-parent={parent || ''}
            data-article-slug={slug}
            style="display: none;"
          >
            <Heading>{entry.data.title}</Heading>
            {entry.data.description && <p class="lab-description">{entry.data.description}</p>}
            <Content />
          </article>

          <div class="lab-article-nav" data-nav-for={slug}>
            {prevSlug && (
              <div class="lab-article-nav-item">
                <span class="lab-article-nav-label">{prevTitle}</span>
                <a class="lab-article-nav-link lab-article-nav-link--prev" href={`#${prevSlug}`}>
                  ← Anterior
                </a>
              </div>
            )}
            {nextSlug && (
              <div class="lab-article-nav-item lab-article-nav-item--next">
                <span class="lab-article-nav-label">{nextTitle}</span>
                <a class="lab-article-nav-link lab-article-nav-link--next" href={`#${nextSlug}`}>
                  Siguiente →
                </a>
              </div>
            )}
          </div>
        </>
      );
    })}
  </main>
</div>

<script>
  // Intercept clicks on home cards to open their first article
  document.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest('.lab-home-card');
    if (card) {
      const article = card.getAttribute('data-article');
      if (article) {
        window.location.hash = article;
      }
    }
  });
</script>
