---
interface Props {
    type?: "note" | "warning" | "tip" | "danger";
    title?: string;
}

const { type = "note", title = "Nota" } = Astro.props;
---

<div class={`callout ${type}`}>
    <div class="callout-title"set:html={title}>
    </div>
    <div class="callout-content">
        <slot />
    </div>
</div>



<style>
    .callout{
        border-radius:12px;
        overflow:hidden;
        margin:2rem 0;
    }

    .callout-title{
        padding:12px 20px;
        font-weight:bold;
    }

    .callout-content{
        padding:20px;
    }

    .callout.note{
        color: #016C9C;
        background:#DDF4F8;
    }

    .callout.note .callout-title{
        color: #FFFFFF;
        background:#24C2E4;
    }

    .callout.warning{
        background:#ffc2c1;
        border: 4px solid #F74946;
        color:var(--text-main);
        margin-bottom: 20px;
    }

    .callout.warning .callout-title{
        background:#F74946;
    }

    .callout.tip{
        color:var(--text-main);
        background:#fff8e5;
        border: 4px solid #fcdb58;
        margin-bottom: 20px;
    }

    .callout.tip .callout-title{
        text-transform:uppercase;
        background:#fcdb58;
    }

    .callout.danger{
        background:#582626;
    }

    .callout.danger .callout-title{
        background:#873434;
    }
</style>